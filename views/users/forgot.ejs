<% layout("/layouts/boilerplate") %>
<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card shadow-sm p-4">
      <h4 class="mb-1">Forgot your password?</h4>
      <p class="text-muted mb-3" style="font-size:0.9rem">Enter your email and we'll send a reset link.</p>
      <form action="/forgot" method="POST">
        <div class="mb-3">
          <label class="form-label">Email address</label>
          <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
        </div>
        <button class="btn btn-dark w-100">Send reset link</button>
      </form>
      <div class="mt-3 text-center" style="font-size:0.87rem">
        <a href="/login">Back to login</a>
      </div>
    </div>
  </div>
</div>
