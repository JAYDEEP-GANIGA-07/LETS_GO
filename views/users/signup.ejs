<% layout("/layouts/boilerplate") %>
<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card shadow-sm p-4">
      <h4 class="mb-1">Create your account</h4>
      <p class="text-muted mb-3" style="font-size:0.9rem">Join millions of hosts and guests on WanderLust.</p>
      <form action="/signup" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <label class="form-label">Username</label>
          <input type="text" name="username" class="form-control" placeholder="Choose a username" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Email address</label>
          <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" minlength="6" placeholder="Min 6 characters" required>
        </div>
        <button class="btn btn-dark w-100">Sign Up</button>
      </form>
      <div class="mt-3 text-center" style="font-size:0.87rem">
        Already have an account? <a href="/login">Log in</a>
      </div>
    </div>
  </div>
</div>
