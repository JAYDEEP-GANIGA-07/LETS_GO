<%layout("/layouts/boilerplate") %>

<style>
    .listing-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.listing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
}

.listing-card .card-img-top {
    transition: transform 0.4s ease;
    overflow: hidden;
}

.listing-card:hover .card-img-top {
    transform: scale(1.05);
}



.filter {
    transition: transform 0.2s ease;
}

.filter:hover {
    transform: translateY(-3px);
}
    #filters{
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter{
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }
    .filter p{
        font-size: 0.8rem;
        margin-bottom: 0;
    }
    .filter:hover{ opacity: 1; }
    .filter.active{
        opacity: 1;
        border-bottom: 2px solid black;
        padding-bottom: 0.3rem;
    }
    .tax-info{ display: none; }
    .tax-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        height: 3rem;
        padding: 1rem;
        margin-left: auto;
        display: flex;
        align-items: center;
    }
    .page-item.active .page-link { background-color: #f72331; border-color: #f72331; }
    .page-link { color: #f72331; }
    .results-count { font-size: 0.85rem; color: #666; margin-top: 1rem; }
</style>

<div id="filters">
    <a href="/listings" class="filter <%= category === '' ? 'active' : '' %>">
        <div><i class="fa-solid fa-globe"></i></div><p>All</p>
    </a>
    <a href="/listings?category=trending" class="filter <%= category === 'trending' ? 'active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div><p>Trending</p>
    </a>
    <a href="/listings?category=rooms" class="filter <%= category === 'rooms' ? 'active' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div><p>Rooms</p>
    </a>
    <a href="/listings?category=iconic city" class="filter <%= category === 'iconic city' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div><p>Iconic city</p>
    </a>
    <a href="/listings?category=mountains" class="filter <%= category === 'mountains' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div><p>Mountains</p>
    </a>
    <a href="/listings?category=castles" class="filter <%= category === 'castles' ? 'active' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div><p>Castles</p>
    </a>
    <a href="/listings?category=amazing pools" class="filter <%= category === 'amazing pools' ? 'active' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div><p>Amazing pools</p>
    </a>
    <a href="/listings?category=camping" class="filter <%= category === 'camping' ? 'active' : '' %>">
        <div><i class="fa-solid fa-campground"></i></div><p>Camping</p>
    </a>
    <a href="/listings?category=farms" class="filter <%= category === 'farms' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tractor"></i></div><p>Farms</p>
    </a>
    <a href="/listings?category=arctic" class="filter <%= category === 'arctic' ? 'active' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div><p>Arctic</p>
    </a>
    <a href="/listings?category=domes" class="filter <%= category === 'domes' ? 'active' : '' %>">
        <div><i class="fa-solid fa-igloo"></i></div><p>Domes</p>
    </a>
    <a href="/listings?category=ports" class="filter <%= category === 'ports' ? 'active' : '' %>">
        <div><i class="fa-solid fa-ship"></i></div><p>Ports</p>
    </a>
    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after Taxes</label>
        </div>
    </div>
</div>

<p class="results-count">
    <% if(search){ %>
        <%= totalListings %> result<%= totalListings !== 1 ? 's' : '' %> for "<%= search %>"
    <% } else if(category){ %>
        <%= totalListings %> listing<%= totalListings !== 1 ? 's' : '' %> in <%= category %>
    <% } %>
</p>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% if(allListings.length === 0){ %>
        <div class="col-12 text-center mt-5">
            <i class="fa-solid fa-house-circle-xmark" style="font-size:3rem; color:#ccc;"></i>
            <p class="mt-3 text-muted">No listings found.</p>
            <a href="/listings" class="btn btn-dark mt-2">View all listings</a>
        </div>
    <% } %>
    <% for(let listing of allListings){ %>
        <a href="/listings/<%=listing._id %>" class="listing-link">
            <div class="card col listing-card">
              <div style="overflow:hidden; border-radius: 1rem;">
    <img src="<%=listing.image.url%>" class="card-img-top" style="height: 20rem;">
</div>
                <div class="card-img-overlay"></div>
                <div class="card-body">
                 <p class="card-text">
    <b><%= listing.title %><br></b>
    <span style="font-size:0.85rem; color:#666;">
        <i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %>
    </span><br>
    &#8377;<%=listing.price.toLocaleString("en-IN")%>/night<br>
    <i class="tax-info">&nbsp;+18% GST</i>
</p>
                </div>
            </div>
        </a>
    <%}%>
</div>

<% if(totalPages > 1){ %>
<nav class="mt-4 d-flex justify-content-center">
    <ul class="pagination">
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/listings?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= category %>">&laquo;</a>
        </li>
        <% for(let i = 1; i <= totalPages; i++){ %>
            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                <a class="page-link" href="/listings?page=<%= i %>&search=<%= search %>&category=<%= category %>"><%= i %></a>
            </li>
        <% } %>
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/listings?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= category %>">&raquo;</a>
        </li>
    </ul>
</nav>
<% } %>

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault")
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info")
        for (info of taxInfo) {
            if (info.style.display != "inline") {
                info.style.display = "inline"
            } else {
                info.style.display = "none"
            }
        }
    })
</script>
